# Copy these values to untracked files on the EC2 instance and replace every
# placeholder before starting services.

# PostgreSQL container environment.
POSTGRES_DB=monthly_goal_tracker
POSTGRES_USER=monthly_goal_tracker
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Go API environment.
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgres://monthly_goal_tracker:replace-with-a-strong-random-password@127.0.0.1:5433/monthly_goal_tracker?sslmode=disable
